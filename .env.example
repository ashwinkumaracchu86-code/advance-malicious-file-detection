# ===========================================
# Malicious File Detection System - Environment
# ===========================================

# Database
DATABASE_URL=sqlite:///./malicious_detection.db

# JWT Authentication
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_SECRET=change-this-to-a-different-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Key (for sensitive data like email passwords)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# CORS - Comma-separated list of allowed origins
# Include the deployed GitHub Pages origin for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://ashwinkumaracchu86-code.github.io

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=5

# File Upload Security
MAX_UPLOAD_SIZE_MB=50

# File Storage
UPLOADS_DIR=./uploads
QUARANTINE_DIR=./quarantine

# ClamAV Antivirus
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# VirusTotal (optional - leave empty to disable)
VIRUSTOTAL_API_KEY=

# Email Monitoring (IMAP)
# Configure via the Email Settings page in the UI
# Or set these defaults:
DEFAULT_IMAP_HOST=imap.gmail.com
DEFAULT_IMAP_PORT=993
DEFAULT_IMAP_SSL=true

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Default Admin (set password for first login, or it will be auto-generated)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
