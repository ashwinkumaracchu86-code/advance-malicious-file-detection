# ============================================================
# Email Monitor - Environment
# Copy this file to .env and fill in your values.
# .env is gitignored - NEVER commit real credentials.
# ============================================================

# --- Server ---
PORT=4000

# --- Monitored mailbox (IMAP) ---
# Option A: configure here (used as fallback if no settings saved in the app).
# For Gmail/Google Workspace use an App Password:
# https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@example.com
IMAP_PASS=
# Address shown as the receiver (defaults to IMAP_USER)
MONITORED_EMAIL=

# --- Security ---
# Key used to encrypt the IMAP password saved from the Settings page.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a key is generated once and stored in data/encryption.key (gitignored).
ENCRYPTION_KEY=

# Optional: require a PIN to open the dashboard and use the API.
# Strongly recommended when deployed publicly. Leave empty to disable.
DASHBOARD_PIN=

# --- Monitoring behaviour ---
# How many recent inbox emails to import on first connect (real mailbox data).
SYNC_LIMIT=25
# Fallback poll interval in seconds (used when the server does not support IDLE).
POLL_INTERVAL=30
# Maximum emails kept in the dashboard history.
MAX_STORED_EMAILS=500
