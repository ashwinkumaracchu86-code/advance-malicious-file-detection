DATABASE_URL=sqlite:///./malicious_detection.db
JWT_SECRET=your-secret-key-change-in-production
SECRET_KEY=your-secret-key-change-in-production
VIRUSTOTAL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MONITOR_FOLDER=
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
WEBHOOK_SLACK_URL=
WEBHOOK_DISCORD_URL=
WEBHOOK_CUSTOM_URL=

# Security Configuration
ENCRYPTION_KEY=
# CORS - Comma-separated list of allowed origins
# Include the deployed GitHub Pages origin for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://ashwinkumaracchu86-code.github.io
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=5
MAX_UPLOAD_SIZE_MB=50
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Monitoring (IMAP) defaults - configurable per-user via the Email Settings page
DEFAULT_IMAP_HOST=imap.gmail.com
DEFAULT_IMAP_PORT=993
DEFAULT_IMAP_SSL=true

# Where quarantined email attachments are stored (shared QUARANTINE_DIR with file quarantine)
QUARANTINE_DIR=./quarantine
